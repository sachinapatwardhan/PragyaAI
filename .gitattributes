# Auto detect text files and normalize to LF in the repository
* text=auto

# C# source
*.cs text
*.csproj text
*.props text
*.targets text
*.sln text
*.slnx text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text
*.razor text
*.css text
*.js text
*.ts text
*.html text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary